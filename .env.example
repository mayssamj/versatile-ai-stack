# ai-stack .env template — fill in your own values (or let the installer generate secrets).
# Generated from the key names in .env; NO real values are included.

HELICONE_API_KEY=
HELICONE_BASE_URL=
BLAXEL_API_KEY=
BLAXEL_WORKSPACE=
GITHUB_TOKEN=
HONCHO_API_KEY=
HONCHO_BASE_URL=
PHOENIX_ADMIN_PASSWORD=
PHOENIX_SECRET=
LITELLM_MASTER_KEY=
PHOENIX_COLLECTOR_HTTP_ENDPOINT=
PHOENIX_PROJECT_NAME=
QDRANT_URL=
PHOENIX_BASE_URL=
LITELLM_BASE_URL=
PHOENIX_API_KEY=
PI_LITELLM_KEY=
ACE_LITELLM_KEY=
ACE_PIN=
HERMES_LITELLM_KEY=
HALO_LITELLM_KEY=
RLM_LITELLM_KEY=

# --- Hermes Telegram gateway (Phase 20) ---
# Bot token from @BotFather for @vz_hermes_controller_bot (format <id>:<secret>).
HERMES_TELEGRAM_BOT_TOKEN=
# SECURITY: the gateway is secure-by-default. With NEITHER of the two below set,
# the bot connects but DENIES every user (it can drive 7 agent profiles, so it
# must not be open by accident). Set ONE of:
#   HERMES_TELEGRAM_ALLOWED_USERS — comma-list of numeric Telegram user ids that
#     may drive the fleet. Find yours by DMing @userinfobot on Telegram.
HERMES_TELEGRAM_ALLOWED_USERS=
#   HERMES_TELEGRAM_ALLOW_ALL=true — open access (anyone who finds the bot). NOT advised.
HERMES_TELEGRAM_ALLOW_ALL=
