# ai-stack .env template — key NAMES only; NO real values are included.
#
# You usually do NOT need to copy this file by hand. Either run the guided
# bootstrap, which fills these in interactively (every key is OPTIONAL and
# skippable) and generates the local secrets for you:
#
#     bash vz-ai-stack.sh setup
#
# …or just run `bash vz-ai-stack.sh install all` — it creates .env, generates
# LITELLM_MASTER_KEY + PHOENIX_SECRET, and offers `setup` on first run.
#
# A LOCAL-ONLY or Claude-SUBSCRIPTION (-sub, incl. opus) setup needs NONE of the
# cloud keys below — local gemma and the subscription models work with the
# generated baseline alone. The -sub models need the Meridian daemon + `claude
# login`, not an API key (see doc/models.md). Fill a key below only to unlock
# that specific cloud provider / integration.

# Docker engine the WHOLE stack uses (main containers + OpenShell gateway).
# One of: orbstack | docker-desktop | colima | podman. Empty = not yet selected;
# set it intentionally with:  vz-ai-stack.sh docker-engine select
AI_STACK_DOCKER_ENGINE=

HELICONE_API_KEY=
HELICONE_BASE_URL=
BLAXEL_API_KEY=
BLAXEL_WORKSPACE=
GITHUB_TOKEN=
HONCHO_API_KEY=
HONCHO_BASE_URL=

# --- Sakana Fugu (opt-in metered route: sakana-fugu / sakana-fugu-ultra) ---
# OpenAI-compatible multi-agent orchestrator (https://sakana.ai/fugu/). Generate at
# console.sakana.ai. Leave empty to keep the routes inert — a keyless/down route
# returns a visible 503 (no silent bill; no cloud->local auto-fallback). Injected into the litellm container by
# bin/start-litellm.sh; run `bin/start-litellm.sh --recreate` after setting it.
SAKANA_API_KEY=
PHOENIX_ADMIN_PASSWORD=
PHOENIX_SECRET=
LITELLM_MASTER_KEY=
PHOENIX_COLLECTOR_HTTP_ENDPOINT=
PHOENIX_PROJECT_NAME=
QDRANT_URL=
PHOENIX_BASE_URL=
LITELLM_BASE_URL=
PHOENIX_API_KEY=
PI_LITELLM_KEY=
ACE_LITELLM_KEY=
ACE_PIN=
HERMES_LITELLM_KEY=
HALO_LITELLM_KEY=
RLM_LITELLM_KEY=
# Scoped key for bin/claude-litellm (Claude Code → any LiteLLM model); mint via doc/CLAUDE-CODE-MODELS.md
CLAUDE_CODE_LITELLM_KEY=

# --- Hermes Telegram gateway (Phase 20) ---
# Bot token from @BotFather for @vz_hermes_controller_bot (format <id>:<secret>).
HERMES_TELEGRAM_BOT_TOKEN=
# SECURITY: the gateway is secure-by-default. With NEITHER of the two below set,
# the bot connects but DENIES every user (it can drive 7 agent profiles, so it
# must not be open by accident). Set ONE of:
#   HERMES_TELEGRAM_ALLOWED_USERS — comma-list of numeric Telegram user ids that
#     may drive the fleet. Find yours by DMing @userinfobot on Telegram.
HERMES_TELEGRAM_ALLOWED_USERS=
#   HERMES_TELEGRAM_ALLOW_ALL=true — open access (anyone who finds the bot). NOT advised.
HERMES_TELEGRAM_ALLOW_ALL=

# --- Hermes Slack role router (Phase 38, opt-in) ---
# Create a Slack app at https://api.slack.com/apps with Socket Mode enabled.
HERMES_SLACK_BOT_TOKEN=
HERMES_SLACK_APP_TOKEN=
# SECURITY: secure-by-default. In role-router mode, operator access requires
# HERMES_SLACK_ALLOWED_USERS=<your Slack member id>. HERMES_SLACK_ALLOW_ALL is
# only honored by the upstream native Slack fallback and does not grant role-router
# operator authority.
HERMES_SLACK_ALLOWED_USERS=
HERMES_SLACK_ALLOW_ALL=
# Optional mission-room/home channel, e.g. hermes_notification. In Milestones 1/2
# this allows channel mentions and mission threads there; it does not create
# proactive notification posts by itself.
HERMES_SLACK_HOME_CHANNEL=
# Default true: ai-stack owns Slack routing so `techlead: ...`, `backend: ...`,
# and `delivery: ...` work through one Slack app. Set false to use upstream
# Hermes' native Slack adapter without virtual role routing.
HERMES_SLACK_ROLE_ROUTER=
# Optional channel whitelist for non-DM replies, comma-list of C/G/D ids. Channel
# mentions are denied unless the channel is listed here or is HERMES_SLACK_HOME_CHANNEL.
HERMES_SLACK_ALLOWED_CHANNELS=
# Optional JSON group override, e.g. {"delivery":["manager","techlead","backend","qa","reviewer"]}
HERMES_SLACK_ROLE_GROUPS=
HERMES_SLACK_DEFAULT_ROLE=
