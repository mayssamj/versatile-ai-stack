#!/usr/bin/env bash
# bin/mempalace-hook-save — env/PATH shim for the vendored upstream
# mempal_save_hook.sh. Generated by Phase 26. Wired via bin/mempalace-hooks.
set -Eeuo pipefail
AI_STACK="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
_mp_get_env() { grep -E "^$1=" "$AI_STACK/.env" 2>/dev/null | head -1 | cut -d= -f2-; }
export PATH="$HOME/.local/bin:$PATH"
_key="$(_mp_get_env MEMPALACE_LITELLM_KEY)"
export MEMPALACE_EMBEDDING_MODEL="${MEMPALACE_EMBEDDING_MODEL:-minilm}"
export MEMPALACE_EMBEDDING_DEVICE="${MEMPALACE_EMBEDDING_DEVICE:-coreml}"
export OPENAI_BASE_URL="http://litellm:4000/v1"
export OPENAI_API_KEY="$_key"
export LLM_ENDPOINT="http://litellm:4000/v1"
export LLM_KEY="$_key"
export LLM_MODEL="local-gemma4"
exec "$AI_STACK/mempalace/hooks/mempal_save_hook.sh" "$@"
