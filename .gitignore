# ── Secrets — NEVER commit ──────────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
!**/.env.template
*.pem
*.key
*.secret
*secret*
*credential*
id_rsa*
id_ed25519*

