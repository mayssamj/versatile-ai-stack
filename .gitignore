# ── Runtime tool trees (generated/installed by phases) ───────────────────
/rlm/
/tools/
/vendor/
/ingestor/.venv/
/ingestor/inbox/
/ingestor/processed/
/pi/.venv/
/pi/node_modules/
/pi/package-lock.json
/pi/pi-bootstrap.tar.gz

# ── Python / Node envs + caches ──────────────────────────────────────────
**/.venv/
**/venv/
**/node_modules/
__pycache__/
*.pyc
*.pyo

# ── Runtime state / data / logs (regenerated) ────────────────────────────
/data/
/data.[0-9]*/
/data.bak-*/
# ── Agent-swarm-sim host venvs + sim data (Phases 32/34, opt-in) ──
# Created at the MAIN checkout on `install 32`/`install 33`/`install 34`: a regenerable uv
# venv plus user sim output (workspace/, sims/). Never repo content — like /data/.
/metagpt/
/agentscope/
/oasis/
# ChatDev (Phase 35, opt-in) — install-generated clone + repo/.env + the Dockerfile
# (Phase 35 re-writes chatdev/Dockerfile via heredoc each install — generated, not a
# tracked seed; tracking it dirtied the file on every install).
/chatdev/
# AI Town (Phase 36, opt-in) — cloned upstream + the bind-mounted Convex world (regenerable/data)
/ai-town/
/data/aitown/
/logs/
# bin/<svc> wrappers are install-generated + machine-path (regenerable, like bin/lumen) — never commit
/bin/metagpt
/bin/agentscope
/bin/oasis
/sourcegraph-local.bak-*.tgz
/traces/
/installer/state/
/CHANGELOG.d/
/temp/
/.remember/
*.log
*.pid

# ── Agent / editor local config ──────────────────────────────────────────
.claude/
# …but DO track the claude-code fleet source-of-truth (THIS path only; the repo-root
# .claude/ [local settings], honcho/.claude, and tools/paperclip/.claude stay ignored).
!agent-profiles/claude-code/.claude/

# ── OS / editor cruft ────────────────────────────────────────────────────
.DS_Store
*.swp
*~
installer/models.yml.bak

# ── Local-only host diagnostics (contain serial/hostname/home-path PII — never commit) ──
ORBSTACK_EDR_EXCLUSION_REQUEST.md
ORBSTACK_CPU_BASELINE_*.md

# ── OpenShell fleet staging — build artifacts (reset-cleared, 04f-regenerated from agent-profiles/) ──
openshell/fleet-souls/
openshell/fleet-bootstrap/

# ── Personal convenience launchers (local-only, not shared) ──
run-mem-palace.sh

# ── Playwright MCP runtime output (transient per-run console logs + page snapshots;
#    the Playwright MCP itself is a Claude Code plugin in ~/.claude, nothing repo-side) ──
.playwright-mcp/

# ── Understand-Anything (Phase 30) — COMMIT the graph, ignore the scratch ──
# The knowledge graph (+ meta/config) is the shared, committed artifact consumed by
# all runtimes. The scratch dirs, fingerprints, and embeddings are regenerable noise.
.understand-anything/intermediate/
.understand-anything/tmp/
.understand-anything/fingerprints.json
.understand-anything/*.embeddings.json
